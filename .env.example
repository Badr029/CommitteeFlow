# ---------------------------------------------------------------------------
# CommitteeFlow environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value here is BACKEND-ONLY. Nothing in this file is compiled into the
# React bundle (spec §63).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API in development (the Vite dev
# server). In production the SPA is served by the same origin, so leave empty.
CORS_ORIGINS=http://localhost:5173
# Trust the first proxy hop (set to 1 when running behind nginx / a company
# reverse proxy terminating TLS, spec §65). 0 disables proxy trust.
TRUST_PROXY=0
LOG_LEVEL=info
# Business-date boundary used for booking validation and current-day plan views.
APP_TIME_ZONE=Africa/Cairo

# --- Database --------------------------------------------------------------
# The browser never talks to PostgreSQL directly (spec §64).
DATABASE_URL=postgres://committeeflow:committeeflow@localhost:5433/committeeflow
PGSSLMODE=disable
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Used only by `npm test` (integration tests truncate this database).
TEST_DATABASE_URL=postgres://committeeflow:committeeflow@localhost:5433/committeeflow_test

# --- Session / security ----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value-before-any-real-deployment
SESSION_NAME=committeeflow.sid
SESSION_TTL_HOURS=12
# Set to `true` ONLY when served over HTTPS (required for real company use).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Login brute-force protection (spec §62)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
WRITE_RATE_LIMIT_WINDOW_MINUTES=1
WRITE_RATE_LIMIT_MAX=60

# --- Email / SMTP (spec §50, §51) -----------------------------------------
# When SMTP_HOST is empty the outbox worker runs in "log" transport mode:
# messages are marked SENT and written to the structured log instead of being
# delivered. This keeps the MVP runnable before company SMTP is provisioned.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="CommitteeFlow <committeeflow@example.com>"
# Absolute URL used in notification emails to link back to the live plan.
APP_PUBLIC_URL=http://localhost:4000
# Outbox worker
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=15000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=6

# BUG-016: persistent recipient batches and bounded delivery. Backend only.
OUTBOX_RECIPIENT_BATCH_SIZE=50
SMTP_SEND_TIMEOUT_MS=30000
OUTBOX_RUN_BUDGET_MS=50000
OUTBOX_LEASE_SECONDS=120
OUTBOX_AMBIGUOUS_RETRY_SECONDS=900
# Maximum SMTP attempts started concurrently by one worker invocation. Keep
# this small because DB_POOL_MAX and serverless instance counts are per process.
OUTBOX_PARENT_CONCURRENCY=2
# Child recipient batches run concurrently within each claimed parent. With the
# defaults, one invocation starts at most 2 x 3 = 6 SMTP sends concurrently.
OUTBOX_CHILD_CONCURRENCY=3
# Host function duration must exceed OUTBOX_RUN_BUDGET_MS plus DB/response margin.
# See qa/BUG-016-Retest.md before enabling deployed workers.

# --- Initial bootstrap account --------------------------------------------
# Used ONLY by `npm run seed`. Change the password immediately after first login.
SEED_ADMIN_NAME=Plan Administrator
SEED_ADMIN_EMAIL=admin@committeeflow.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
